rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && userDoc().data.role != null ? userDoc().data.role : 'viewer'; }
    function isAdmin() { return signedIn() && role() in ['admin','principal']; }
    function isManager() { return signedIn() && role() in ['admin','principal','vice_principal','council','team_leader']; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /staff/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /criteria/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /evaluations/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isManager() || resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /auditLogs/{docId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
