rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() && userDoc().data.role; }
    function isAdmin() { return role() in ['ADMIN','HIEU_TRUONG']; }
    function isCouncil() { return role() in ['ADMIN','HIEU_TRUONG','BGH','TO_TRUONG']; }
    match /settings/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /users/{uid} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /departments/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /criteria/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /periods/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /evaluations/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.employeeUid == request.auth.uid || isCouncil();
      allow update: if isCouncil() || (resource.data.employeeUid == request.auth.uid && resource.data.locked != true);
      allow delete: if isAdmin();
    }
    match /auditLogs/{id} { allow read: if isCouncil(); allow create: if signedIn(); allow update, delete: if false; }
  }
}
